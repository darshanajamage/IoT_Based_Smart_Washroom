<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Needed so a safety alert can be shown on the lock screen (Android 13+).
        The user is asked for this permission the first time the app is opened.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Network permissions for Firebase Realtime Database and Cloud Messaging -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        The app only prepares a phone call, so a device without a dialler (for
        example a tablet) can still install the app.
    -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!--
        Needed on Android 11 and newer so the app can check whether Google Maps
        is installed on the device.
    -->
    <queries>
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:name=".SafetyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartWashroom">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AlertActivity"
            android:exported="false"
            android:label="@string/alert_screen_title" />

        <activity
            android:name=".ui.ContactsActivity"
            android:exported="false"
            android:label="@string/contacts_title" />

        <activity
            android:name=".ui.ContactEditActivity"
            android:exported="false"
            android:label="@string/contact_add_title" />

        <activity
            android:name=".ui.AlertHistoryActivity"
            android:exported="false"
            android:label="@string/history_title" />

        <activity
            android:name=".ui.DemoModeActivity"
            android:exported="false"
            android:label="@string/demo_title" />

        <activity
            android:name=".ui.NearbyHospitalsActivity"
            android:exported="false"
            android:label="@string/hospitals_title" />

        <!-- Firebase Cloud Messaging Service -->
        <service
            android:name=".SafetyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
