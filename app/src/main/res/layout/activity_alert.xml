<?xml version="1.0" encoding="utf-8"?>
<!--
  ALERT WARNING SCREEN
  Shown when a "no motion" or "emergency button" alert is active. The colours are
  changed at runtime so that a no-motion alert is amber and an emergency alert is
  red.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_page"
    android:orientation="vertical"
    tools:context=".ui.AlertActivity">

    <FrameLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/alert_danger">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/alert_screen_title"
            app:titleTextColor="@color/text_on_dark" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ================= Big warning banner ================= -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/alert_banner_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/alert_danger_light"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/alert_danger"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <FrameLayout
                            android:id="@+id/alert_icon_background"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/alert_danger">

                            <ImageView
                                android:id="@+id/iv_alert_icon"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/alert_screen_title"
                                android:src="@drawable/ic_emergency"
                                app:tint="@color/text_on_dark" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_alert_type"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="EMERGENCY BUTTON PRESSED" />

                        <TextView
                            android:id="@+id/tv_alert_demo_badge"
                            style="@style/Widget.SmartBathroomSafety.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_pill"
                            android:backgroundTint="@color/alert_warning"
                            android:text="@string/alert_demo_badge"
                            android:textColor="@color/text_on_dark"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/tv_alert_explainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.SmartBathroomSafety.Body"
                            tools:text="The emergency button on the device was pressed." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ================= Alert details ================= -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/alert_details_title"
                            android:textAppearance="@style/TextAppearance.SmartBathroomSafety.SectionTitle" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/alert_label_type"
                                android:textAppearance="@style/TextAppearance.SmartBathroomSafety.Body" />

                            <TextView
                                android:id="@+id/tv_detail_type"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                tools:text="NO MOTION DETECTED" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/alert_label_date"
                                android:textAppearance="@style/TextAppearance.SmartBathroomSafety.Body" />

                            <TextView
                                android:id="@+id/tv_detail_date"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:textColor="@color/text_primary"
                                tools:text="21 Oct 2026" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/alert_label_time"
                                android:textAppearance="@style/TextAppearance.SmartBathroomSafety.Body" />

                            <TextView
                                android:id="@+id/tv_detail_time"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:textColor="@color/text_primary"
                                tools:text="10:32 PM" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/alert_label_device_status"
                                android:textAppearance="@style/TextAppearance.SmartBathroomSafety.Body" />

                            <TextView
                                android:id="@+id/tv_detail_device_status"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                tools:text="ONLINE" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/alert_label_source"
                                android:textAppearance="@style/TextAppearance.SmartBathroomSafety.Body" />

                            <TextView
                                android:id="@+id/tv_detail_source"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                tools:text="DEMO (simulated)" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ================= Actions ================= -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_call_family"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:text="@string/action_call_family"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    app:icon="@drawable/ic_phone"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_open_hospitals"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:text="@string/action_open_hospitals"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    app:icon="@drawable/ic_hospital"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_acknowledge"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/action_acknowledge"
                    android:textAllCaps="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/action_call_family_desc"
                    android:textAppearance="@style/TextAppearance.SmartBathroomSafety.Body"
                    android:textSize="12sp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="16dp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
